# ==============================================================================
# CAMPUSLOOP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe placeholder configuration file for CampusLoop.
# Copy this file to .env and provide your Supabase project credentials.
#
# IMPORTANT:
# - Never commit your real .env file or private credentials to source control.
# - Never put Supabase service-role keys in this file or any frontend code.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (Safe for browser / frontend usage)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
